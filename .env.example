# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resend → API Keys (used from step 2 onwards, for booking confirmations
# and the 24-hour reminder)
RESEND_API_KEY=
EMAIL_FROM="Winning Minds <hello@your-domain.com>"

# Secret the reminder cron must send as `Authorization: Bearer ...`
CRON_SECRET=
