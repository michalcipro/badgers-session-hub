# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Same page, "service_role". Bypasses every access rule — server only,
# never expose it to the browser. Used by the reminder cron.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend → API Keys. Without these, booking still works and the emails
# are skipped with a warning in the log.
RESEND_API_KEY=
EMAIL_FROM="Winning Minds <hello@your-domain.com>"

# Any long random string. Vercel sends it to the cron as a bearer token.
CRON_SECRET=
